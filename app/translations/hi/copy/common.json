  "common.gameScene": {
   "source": "12183c2d8caf2d",
   "english": "Game scene. Tap or click in it, or use the arrow keys and Space. The words under the scene say how to play.",
   "text": "गेम का सीन। इसमें टैप या क्लिक करें, या एरो कीज़ और स्पेस का इस्तेमाल करें। सीन के नीचे लिखा है कि कैसे खेलना है।",
   "status": "machine",
   "made": "2026-10-05 gemini-3.8-flash"
  },
