# Copy to .env.local and fill in. Nothing here is a secret yet.

# PostgreSQL. `docker compose up -d` starts one on this address.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/iopener

# Signs the sign-in and child-mode cookies. At least 16 characters. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated emails that are always super admins, so the owner is never locked out.
ADMIN_EMAILS=

# The demo sign-in page (pick a seeded person). Set to "off" in production, where Firebase signs people in.
DEMO_LOGIN=on

# Sign-in with Google and by email link (Firebase Authentication). It switches on when the first two are set.
# How it works and what to switch on in the Firebase console: docs/SIGN-IN.md.
# The id of the Firebase project that holds the sign-in accounts.
FIREBASE_PROJECT_ID=
# That project's web API key. It names the project to Google and is not a secret. Only the server uses it.
FIREBASE_API_KEY=
# The web client id of Google sign-in (it ends in .apps.googleusercontent.com). Left empty, only the email link is offered.
GOOGLE_CLIENT_ID=
# How many servers in front of the app add to the forwarded-for list. 0 when Cloud Run is reached directly, 1 behind Firebase Hosting.
# The limit on sign-in emails counts by network address, and a wrong number here makes every visitor look like one.
SIGNIN_PROXY_HOPS=0
# Development only: the address of the stand-in for Firebase started with `npx tsx scripts/signin-stand-in.ts`.
# It is ignored in production, and anywhere unless it is an http address on this machine.
SIGNIN_STAND_IN=

# The public address of the site, used for links in the sitemap and when a page is shared.
# The sign-in link in an email comes back to this address, so it must be the real one, and https in production.
SITE_URL=http://localhost:3000

# An access phrase of 8 characters or more locks the whole site behind one question. Leave empty for an open site.
# Use it for a staging copy and for the days before launch.
SITE_LOCK=

# The secret a scheduler sends in the header x-job-secret when it calls /api/jobs/daily and /api/jobs/weekly.
# 16 characters or more. Left empty, those addresses do not exist.
JOB_SECRET=

# Spoken instructions (the Listen buttons). The audio and its list, manifest.json, are made ahead of time and kept
# in one of two places. With neither set there are no Listen buttons and nothing else changes. See src/voice/store.ts.
# A folder on this machine. While developing, a folder named "voice" beside this app folder is used when this is empty.
VOICE_DIR=
# Or the name of a private Cloud Storage bucket. The server reads it as the identity it runs as; a browser never does.
VOICE_BUCKET=
